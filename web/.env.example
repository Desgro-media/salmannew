DATABASE_URL="postgresql://salman:salman@localhost:5442/salman_perfumes"

# Generate with: openssl rand -base64 32
SESSION_SECRET="generate-a-long-random-string"

# Used only by `npm run db:seed` to create the first superadmin account.
SEED_SUPERADMIN_EMAIL="admin@example.com"
SEED_SUPERADMIN_PASSWORD="change-me-before-seeding"

# From a Vercel Blob store attached to this project (auto-injected on Vercel;
# run `vercel env pull` or set manually for local dev).
BLOB_READ_WRITE_TOKEN=""

# Shared secret for POST /api/revalidate, which clears the storefront page cache
# after a write that bypassed the app (prisma/sync-catalogue.ts). Must be set on
# the deployment for the endpoint to work at all — it denies every request when
# unset, so a misconfigured deploy can't leave it open.
# Generate with: openssl rand -base64 32
REVALIDATE_SECRET="generate-a-long-random-string"

# Where sync-catalogue.ts sends that purge. Leave unset to skip it and let the
# 60s ISR window handle the refresh instead.
# e.g. https://salmannew-six.vercel.app/api/revalidate
REVALIDATE_URL=""
