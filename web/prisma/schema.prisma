generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  SUPERADMIN
}

enum Category {
  Oriental
  Fresh
  Floral
  Woody
  Musk
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
}

model Product {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  fullName      String
  tagline       String
  category      Category
  description   String        @db.Text
  story         String        @db.Text
  notesTop      String[]
  notesHeart    String[]
  notesBase     String[]
  concentration String
  accent        String
  images        String[]
  bestseller    Boolean       @default(false)
  isNew         Boolean       @default(false)
  isArchived    Boolean       @default(false)
  sizes         ProductSize[]
  orderItems    OrderItem[]
  reviews       Review[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int
  title      String?
  body       String   @db.Text
  photos     String[]
  // Resolved once, when the review is written, rather than joined on read:
  // the badge should reflect whether they had actually bought it at the time,
  // and it keeps the product-page query off the orders table entirely.
  verifiedPurchase Boolean @default(false)
  // "Publish immediately, remove later" — admins flip this instead of deleting
  // so a hidden review can be restored and the author can't silently repost.
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // One review per customer per product; posting again edits the existing one.
  @@unique([productId, customerId])
  @@index([productId, isHidden, createdAt])
}

model ProductSize {
  id             String      @id
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  label          String
  volumeMl       Int
  sku            String      @unique
  // Whole rupees, matching current app behavior (formatPrice renders 0 decimals,
  // paise are never used or displayed anywhere in this app).
  price          Int
  compareAtPrice Int?
  image          String
  thumb          String
  orderItems     OrderItem[]

  @@index([productId])
}

model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  address      String?
  city         String?
  state        String?
  pincode      String?
  createdAt    DateTime @default(now())
  orders       Order[]
  reviews      Review[]
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  status            String      @default("received")
  subtotal          Int
  shipping          Int         @default(0)
  total             Int
  customerId        String?
  customer          Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerFullName  String
  customerEmail     String
  customerPhone     String
  customerAddress   String
  customerCity      String
  customerState     String
  customerPincode   String
  estimatedDelivery DateTime
  items             OrderItem[]
  createdAt         DateTime    @default(now())

  @@index([customerEmail])
  @@index([customerId])
}

// Denormalizes name/price/image/sizeLabel/sku at purchase time so historical
// orders stay accurate even if the product is later renamed or repriced.
model OrderItem {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  sizeId    String
  size      ProductSize @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  name      String
  sizeLabel String
  price     Int
  image     String
  quantity  Int
  sku       String

  @@index([productId])
  @@index([sizeId])
}
