generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  SUPERADMIN
  DELIVERY
}

// Prive is the second product line rather than a scent family. Spelled without
// the accent because enum members must be plain identifiers; the UI puts it
// back via categoryLabel() in src/lib/shop-filters.ts.
enum Category {
  Prive
  Oriental
  Fresh
  Floral
  Woody
  Musk
}

// Storefront values the shop owner changes without a deploy. One row, always
// id 1 — a CHECK constraint in the migration enforces that rather than trusting
// every caller to remember, because a second row would silently become a second
// set of prices and which one won would depend on query order.
//
// Money is in whole rupees, like every other price in this schema.
model StoreSettings {
  id                    Int      @id @default(1)
  shippingFee           Int      @default(50)
  // Order subtotal at or above which shipping is waived. Read by checkout and
  // by the marquee/product-page copy alike, so the advertised figure and the
  // charged one cannot drift apart.
  freeShippingThreshold Int      @default(2999)
  updatedAt             DateTime @updatedAt
}

model Admin {
  id            String             @id @default(cuid())
  email         String             @unique
  passwordHash  String
  role          AdminRole          @default(ADMIN)
  // Display name for delivery boys (and, optionally, other staff) in admin UI.
  // Unset for the seeded superadmin, so it stays nullable.
  name          String?
  createdAt     DateTime           @default(now())
  statusChanges OrderStatusEvent[]
}

model Product {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  fullName      String
  tagline       String
  category      Category
  description   String        @db.Text
  story         String        @db.Text
  notesTop      String[]
  notesHeart    String[]
  notesBase     String[]
  concentration String
  accent        String
  images        String[]
  bestseller    Boolean       @default(false)
  // Drives the shop's "Signature Collection" type filter. Stored rather than
  // derived from the category so the shop owner picks what's in it — it used to
  // mean "anything that isn't Privé", which no one could change.
  signature     Boolean       @default(false)
  isNew         Boolean       @default(false)
  isArchived    Boolean       @default(false)
  sizes         ProductSize[]
  orderItems    OrderItem[]
  reviews       Review[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int
  title      String?
  body       String   @db.Text
  photos     String[]
  // Resolved once, when the review is written, rather than joined on read:
  // the badge should reflect whether they had actually bought it at the time,
  // and it keeps the product-page query off the orders table entirely.
  verifiedPurchase Boolean @default(false)
  // "Publish immediately, remove later" — admins flip this instead of deleting
  // so a hidden review can be restored and the author can't silently repost.
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // One review per customer per product; posting again edits the existing one.
  @@unique([productId, customerId])
  @@index([productId, isHidden, createdAt])
}

model ProductSize {
  id             String      @id
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  label          String
  volumeMl       Int
  sku            String      @unique
  // Whole rupees, matching current app behavior (formatPrice renders 0 decimals,
  // paise are never used or displayed anywhere in this app).
  price          Int
  compareAtPrice Int?
  image          String
  thumb          String
  // Retiring a size cannot mean deleting the row: OrderItem points here with
  // onDelete: Restrict, so any size that has ever been bought refuses to go,
  // and past orders should keep their link regardless. Archiving takes it off
  // the storefront and leaves history intact — same device as Product.isArchived.
  isArchived     Boolean     @default(false)
  orderItems     OrderItem[]

  @@index([productId])
}

model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  address      String?
  city         String?
  state        String?
  pincode      String?
  createdAt    DateTime @default(now())
  orders       Order[]
  reviews      Review[]
}

// Fulfilment checkpoints, in the order a parcel passes through them. CANCELLED
// is deliberately last and off that line — it is a terminal state that can be
// reached from anywhere, not a further step along the way.
enum OrderStatus {
  RECEIVED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

// Deliberately separate from OrderStatus: money and parcels move independently.
// An order can be PAID and still sit at RECEIVED, and a REFUNDED one keeps
// whatever fulfilment state it had reached when the refund was issued.
//
// PENDING is the state every order is born in — the row exists so the Razorpay
// order has something to point back at, but nobody has paid yet. Those rows are
// abandoned carts, not orders, and are kept out of the fulfilment queue.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id                String             @id @default(cuid())
  orderNumber       String             @unique
  status            OrderStatus        @default(RECEIVED)
  paymentStatus     PaymentStatus      @default(PENDING)
  subtotal          Int
  shipping          Int                @default(0)
  total             Int
  // Razorpay's own order id (`order_...`), created before the customer is sent
  // to the gateway. Unique because it is what the webhook matches on, and two
  // of our orders must never claim the same payment. Null only for the orders
  // placed before payments existed.
  razorpayOrderId   String?            @unique
  razorpayPaymentId String?
  paidAt            DateTime?
  customerId        String?
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerFullName  String
  customerEmail     String
  customerPhone     String
  customerAddress   String
  customerCity      String
  customerState     String
  customerPincode   String
  estimatedDelivery DateTime
  items             OrderItem[]
  statusEvents      OrderStatusEvent[]
  createdAt         DateTime           @default(now())

  @@index([customerEmail])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
}

// One row per checkpoint the order has actually reached. Order.status is the
// current stage; this is how it got there. Kept as an append-only log rather
// than a set of timestamp columns on Order so the customer-facing timeline can
// show a real date against every step, and so there is an audit trail of which
// admin advanced what — a single mutable status field would lose both.
model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  // Optional customer-visible line, e.g. a courier name or a delay explanation.
  note      String?
  // Null for the RECEIVED event raised by checkout itself, and for any admin
  // account deleted after acting. SetNull keeps the history rather than the actor.
  adminId   String?
  admin     Admin?      @relation(fields: [adminId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

// Denormalizes name/price/image/sizeLabel/sku at purchase time so historical
// orders stay accurate even if the product is later renamed or repriced.
model OrderItem {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  sizeId    String
  size      ProductSize @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  name      String
  sizeLabel String
  price     Int
  image     String
  quantity  Int
  sku       String

  @@index([productId])
  @@index([sizeId])
}
